<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Product sets" name="product_sets" attrs="{'invisible': [('product_set_ids', '=', [])]}">
                    <div class="o_row">
                        <button name="action_set_sections" type="object" string="Update set sections" help="Re-order sections for set in lines" class="btn-link mb-1 px-0" icon="fa-refresh" confirm="This will update all sequences in lines and recreate the sections." attrs="{'invisible': ['|', ('product_set_ids', '=', []), ('state', 'in', ['sale', 'done','cancel'])]}"/>
                    </div>
                    <field name="product_set_ids" mode="tree">
                        <tree>
                            <field name="move_id" invisible="1"/>
                            <field name="product_set_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                <control>
                    <button name="%(act_open_wizard_product_set_add_from_invoice)d"
                            class="btn-link"
                            type="action"
                            string="Add set"
                            context="{'default_move_id': parent.id, 'default_partner_id': parent.partner_id, 'active_id': parent.id, 'active_model': 'account.move'}"/>
                </control>
                <field name="product_set_id"
                       options='{"no_create": True}'
                       optional="hide"/>
                <field name="product_set_line_id"
                       optional="hide"
                       context="{'search_default_product_set_id': product_set_id, 'default_product_set_id': product_set_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
